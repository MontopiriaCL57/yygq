# 仅供参考：静态站点 + /api + /cs2bp 反代（server_name 换成你的域名）
server {
    listen 80;
    server_name example.com;

    root /srv/yygq/site;      # 指向本仓库 site/ 目录
    index index.html;

    # 留言板旧路径
    location = /xiaoheishu { rewrite ^ /xiaoheishu.html last; }

    # 干净 URL：/forum/login -> /forum/login.html
    location / { try_files $uri $uri/ @cleanurl; }
    location @cleanurl { rewrite ^(.*[^/])/?$ $1.html last; }

    # 主站 API
    location /api {
        proxy_pass http://127.0.0.1:8808;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # CS2 BP 工具（含 WebSocket）
    location = /cs2bp { return 301 /cs2bp/; }
    location /cs2bp/socket.io/ {
        proxy_pass http://127.0.0.1:4900/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location /cs2bp/ {
        proxy_pass http://127.0.0.1:4900/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
